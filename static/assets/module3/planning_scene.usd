#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Environments"
    {
    }

    def Xform "Looks"
    {
    }

    def Xform "Robots"
    {
        # Placeholder for a robot model
        def Xform "MyRobot"
        {
            float3 xformOp:scale = (1, 1, 1)
            float3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOp:order = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            
            # Example: add a simple visual component to represent the robot
            def Cube "BaseLink"
            {
                float3 xformOp:scale = (0.3, 0.3, 0.3)
                float3 xformOp:translate = (0, 0, 0.15)
                color3f[] primvars:displayColor = [(0.7, 0.7, 0.7)]
            }
        }
    }

    def Xform "Obstacles"
    {
        def Cube "Obstacle1"
        {
            float3 xformOp:scale = (0.2, 0.2, 0.8)
            float3 xformOp:translate = (0.5, 0.5, 0.4)
            color3f[] primvars:displayColor = [(1, 0, 0)]
            uniform token[] xformOp:order = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
        def Cylinder "Obstacle2"
        {
            float radius = 0.15
            float height = 0.6
            float3 xformOp:translate = (-0.4, 0.6, 0.3)
            color3f[] primvars:displayColor = [(0, 1, 0)]
            uniform token[] xformOp:order = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }
}