ntMatter":{"sidebar_position":1},"sidebar":"courseSidebar","previous":{"title":"Module 3: The AI-Robot Brain (NVIDIA Isaac)","permalink":"/docs/module3-ai-brain"},"next":{"title":"Chapter 2: Isaac Sim for Advanced Perception Tasks","permalink":"/docs/module3-ai-brain/chapter2-isaac-perception-tasks"}},{"id":"module3-ai-brain/chapter2-isaac-perception-tasks","title":"Chapter 2: Isaac Sim for Advanced Perception Tasks","description":"NVIDIA Isaac Sim provides a robust environment for developing and testing advanced perception algorithms critical for autonomous robotics. Leveraging its physically accurate rendering and USD-based scene description, Isaac Sim can generate high-fidelity synthetic data, which is invaluable for training and validating AI models for various perception tasks.","source":"@site/docs/module3-ai-brain/chapter2-isaac-perception-tasks.mdx","sourceDirName":"module3-ai-brain","slug":"/module3-ai-brain/chapter2-isaac-perception-tasks","permalink":"/docs/module3-ai-brain/chapter2-isaac-perception-tasks","draft":false,"unlisted":false,"editUrl":"https://github.com/Physical-AI-Humanoid-Robotics-Textbook/tree/main/docs/module3-ai-brain/chapter2-isaac-perception-tasks.mdx","tags":[],"version":"current","sidebarPosition":2,"frontMatter":{"sidebar_position":2},"sidebar":"courseSidebar","previous":{"title":"Chapter 1: Introduction to NVIDIA Isaac Sim","permalink":"/docs/module3-ai-brain/chapter1-isaac-sim-introduction"},"next":{"title":"Chapter 3: Motion Planning and Control in Isaac Sim","permalink":"/docs/module3-ai-brain/chapter3-motion-planning-control"}},{"id":"module3-ai-brain/chapter3-motion-planning-control","title":"Chapter 3: Motion Planning and Control in Isaac Sim","description":"Motion planning and control are core challenges in robotics, enabling robots to navigate their environment and interact with objects. For complex systems like humanoid robots, these tasks become significantly more intricate. NVIDIA Isaac Sim provides powerful tools and integrations to develop, test, and refine motion planning and control algorithms in a realistic and simulated environment.","source":"@site/docs/module3-ai-brain/chapter3-motion-planning-control.mdx","sourceDirName":"module3-ai-brain","slug":"/module3-ai-brain/chapter3-motion-planning-control","permalink":"/docs/module3-ai-brain/chapter3-motion-planning-control","draft":false,"unlisted":false,"editUrl":"https://github.com/Physical-AI-Humanoid-Robotics-Textbook/tree/main/docs/module3-ai-brain/chapter3-motion-planning-control.mdx","tags":[],"version":"current","sidebarPosition":3,"frontMatter":{"sidebar_position":3},"sidebar":"courseSidebar","previous":{"title":"Chapter 2: Isaac Sim for Advanced Perception Tasks","permalink":"/docs/module3-ai-brain/chapter2-isaac-perception-tasks"},"next":{"title":"Chapter 4: ROS 2 Integration with Isaac Sim","permalink":"/docs/module3-ai-brain/chapter4-ros2-isaac-integration"}},{"id":"module3-ai-brain/chapter4-ros2-isaac-integration","title":"Chapter 4: ROS 2 Integration with Isaac Sim","description":"The Robot Operating System (ROS 2) is a flexible framework for writing robot software, providing tools, libraries, and conventions for building complex robot applications. Integrating ROS 2 with NVIDIA Isaac Sim combines the strengths of both platforms: Isaac Sim's high-fidelity simulation and synthetic data generation capabilities with ROS 2's powerful ecosystem for robot control, communication, and navigation.","source":"@site/docs/module3-ai-brain/chapter4-ros2-isaac-integration.mdx","sourceDirName":"module3-ai-brain","slug":"/module3-ai-brain/chapter4-ros2-isaac-integration","permalink":"/docs/module3-ai-brain/chapter4-ros2-isaac-integration","draft":false,"unlisted":false,"editUrl":"https://github.com/Physical-AI-Humanoid-Robotics-Textbook/tree/main/docs/module3-ai-brain/chapter4-ros2-isaac-integration.mdx","tags":[],"version":"current","sidebarPosition":4,"frontMatter":{"sidebar_position":4},"sidebar":"courseSidebar","previous":{"ti